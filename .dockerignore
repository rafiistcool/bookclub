# Build context of the root Dockerfile (the production image). It needs only frontend/ and
# server/, so everything else stays out: .git, .cargo (the untracked worktree settings),
# backend/, docs/, deploy/ and data/.
*
!frontend/
!server/

# Inside frontend/: the image installs the dependencies and builds dist/ itself.
frontend/node_modules
frontend/dist

# Inside server/: the build output (many GB on a dev machine) and local settings.
server/target
server/.cargo
server/data
server/.env

# Anywhere.
**/.DS_Store
**/*.log
