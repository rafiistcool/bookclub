  "query": "INSERT INTO sessions (user_id, kind, token_hash, label, expires_at)\n           VALUES ($1, $2, $3, $4,\n                   now() + CASE $2 WHEN 'cookie' THEN interval '30 days' ELSE interval '90 days' END)\n           RETURNING id, label, created_at, last_used_at",
