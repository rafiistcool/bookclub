  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.work_id, u.username AS \"set_by?\", p.note, p.started_at, p.ended_at,\n                  p.meeting_at\n           FROM club_picks p\n           LEFT JOIN users u ON u.id = p.set_by\n           WHERE p.club_id = $1 AND p.ended_at IS NOT NULL\n           ORDER BY p.ended_at DESC, p.id DESC",
