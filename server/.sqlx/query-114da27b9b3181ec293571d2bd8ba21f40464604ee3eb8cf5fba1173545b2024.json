  "query": "SELECT b.nomination_id, b.user_id, u.username\n         FROM next_up_ballots b\n         JOIN club_memberships m ON m.club_id = b.club_id AND m.user_id = b.user_id\n         JOIN users u ON u.id = b.user_id\n         WHERE b.vote_id = $1",
