{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (u.id) u.id, u.username, u.email AS \"email!\", u.locale,\n                  r.status AS \"status!\"\n           FROM reports r\n           JOIN users u ON u.id = r.created_by\n           WHERE r.resolved_by = $1 AND r.resolved_at = now()\n             AND u.email_verified_at IS NOT NULL\n           ORDER BY u.id, r.id",
