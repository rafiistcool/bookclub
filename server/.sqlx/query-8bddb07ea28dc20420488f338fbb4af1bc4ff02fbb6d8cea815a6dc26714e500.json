  "query": "SELECT u.id, u.username, m.public_id AS \"avatar_public_id?\", f.since AS \"since!\"\n           FROM bc_friends($1) f\n           JOIN users u ON u.id = f.user_id\n           LEFT JOIN media m ON m.id = u.avatar_media_id AND m.removed_at IS NULL\n           ORDER BY u.username",
