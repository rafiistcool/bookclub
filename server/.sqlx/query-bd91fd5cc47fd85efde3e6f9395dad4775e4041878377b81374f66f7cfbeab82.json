  "query": "SELECT p.id, u.username\n           FROM posts p\n           JOIN posts parent ON parent.id = p.parent_id\n           JOIN users u ON u.id = parent.author_id\n           JOIN bc_visible_owners($1) AS o ON o.user_id = parent.author_id\n           WHERE p.id = ANY($2)",
