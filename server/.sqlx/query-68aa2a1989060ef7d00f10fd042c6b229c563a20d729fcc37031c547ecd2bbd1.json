  "db_name": "PostgreSQL",
  "query": "SELECT u.username, u.locale, u.email, u.email_verified_at IS NOT NULL AS \"verified!\",\n                  u.password_hash,\n                  (SELECT t.email FROM email_tokens t\n                   WHERE t.user_id = u.id AND t.purpose = 'verify_email'\n                     AND t.used_at IS NULL AND t.expires_at > now()\n                   ORDER BY t.id DESC LIMIT 1) AS open_change\n           FROM users u\n           WHERE u.id = $1\n           FOR UPDATE",
