  "query": "SELECT l.id AS loser_id, l.created_at AS loser_at, w.id AS winner_id,\n                w.created_at AS winner_at\n         FROM next_up_nominations l\n         JOIN next_up_nominations w ON w.vote_id = l.vote_id AND w.work_id = $2\n         WHERE l.work_id = $1\n         ORDER BY l.vote_id",
