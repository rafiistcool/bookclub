{
  "db_name": "PostgreSQL",
  "query": "SELECT p.work_id, c.slug, c.name\n           FROM club_picks p\n           JOIN bc_member_clubs($1) AS mc ON mc.club_id = p.club_id\n           JOIN clubs c ON c.id = p.club_id\n           WHERE p.ended_at IS NULL AND p.work_id = ANY($2)\n           ORDER BY mc.joined_at DESC, c.id",
