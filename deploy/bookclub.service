[Unit]
Description=Bookclub
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=bookclub
Group=bookclub
WorkingDirectory=/opt/bookclub/backend
EnvironmentFile=/opt/bookclub/.env
Environment=DEBUG=0
ExecStart=/opt/bookclub/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

# Put a TLS proxy (Caddy, nginx, Tailscale Serve) in front of 127.0.0.1:8000.

[Install]
WantedBy=multi-user.target
