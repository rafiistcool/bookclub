# The nightly backup (deploy/hosted/README.md, "Backups"), started by bookclub-backup.timer.
# By hand: systemctl start bookclub-backup; the log: journalctl -u bookclub-backup.
[Unit]
Description=Bookclub backup: database dump and media to restic
Documentation=https://git.tillhome.de/rafiistcool/bookclub/src/branch/main/deploy/hosted/README.md
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/opt/bookclub/backup.sh
# Below the app for CPU and disk.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The weekly check reads back 5 % of the repository.
TimeoutStartSec=4h
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
