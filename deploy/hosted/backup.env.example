# Bookclub, hosted: the settings of backup.sh, restore-test.sh and update.sh (README.md,
# "Backups" and "Updates and rollback"). update.sh reads this file because every update starts
# with backup.sh, which must back up the stack in the same COMPOSE_DIR.
#
# Copy this file to backup.env next to the scripts (chmod 600), and set the repository and the
# heartbeat URLs. The scripts read it as a shell file: no spaces around "=", and no spaces in
# values. restic reads the RESTIC_* and AWS_* variables itself.

# ---- What is backed up ------------------------------------------------------------------------

# The directory with compose.yaml and .env; the scripts run `docker compose` there.
COMPOSE_DIR=/opt/bookclub
# The pictures on the host: BOOKCLUB_DATA_DIR/media of .env. backup.sh refuses to run when the
# app container mounts another directory.
MEDIA_DIR=/srv/bookclub/media
# The scripts' own directory (mode 0700): db/ with the newest dump and its counts, the restic
# cache, the restore test's scratch space, the last run's log and the lock.
BACKUP_DIR=/var/lib/bookclub-backup
# A snapshot holds BACKUP_DIR/db and MEDIA_DIR under these paths, and the restore test looks for
# them there: after changing either, run backup.sh once before the next restore test.

# ---- restic -----------------------------------------------------------------------------------

# The repository. For a Hetzner Storage Box (Q9), `bookclub-backup` is the Host entry in
# RESTIC_SSH_DIR/config with the box's user, port 23 and the key (README.md, "Backups"), and
# `bookclub` a directory in the box's home. A local path or an s3:… URL (with the AWS_* below)
# works too.
RESTIC_REPOSITORY=sftp:bookclub-backup:bookclub
# The repository password, alone in a file (chmod 600). Keep a copy in the password manager:
# without it no backup can be read.
RESTIC_PASSWORD_FILE=/opt/bookclub/restic-password
# Only for an s3:… repository.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
# restic runs from this image with the caller's uid (root under systemd).
RESTIC_IMAGE=restic/restic:0.17.3
# Only for an sftp repository: the ssh key, config and known_hosts, mounted read-only.
RESTIC_SSH_DIR=/root/.ssh
# The host name of the snapshots. Give staging another one if it ever shares the repository.
BACKUP_HOST=bookclub

# ---- Checks and monitoring --------------------------------------------------------------------

# The day of the week (1 Monday … 7 Sunday) on which backup.sh also reads back 5 % of the data.
CHECK_WEEKDAY=7
# Heartbeat URLs in the style of healthchecks.io (https://hc-ping.com/<uuid>). Each run pings
# <url>/start, then <url>/<exit status> with the end of its log. Empty: no ping.
BACKUP_HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=
# The restore test's throwaway database: the major version of compose.yaml's postgres.
RESTORE_POSTGRES_IMAGE=postgres:17

# ---- Automatic updates (update.sh) ------------------------------------------------------------

# The heartbeat of update.sh, which bookclub-update.timer starts every 3 minutes. A check that
# finds the app up to date and healthy pings <url>/0; an update pings <url>/start, then
# <url>/<exit status> with the end of its log; an unhealthy app pings <url>/1. Empty: no ping.
UPDATE_HEARTBEAT_URL=
# How long update.sh waits for the new app container to turn healthy, in seconds. The image's
# healthcheck allows 60 s for the start, and the migrations run before the server answers.
UPDATE_WAIT_SECONDS=300
