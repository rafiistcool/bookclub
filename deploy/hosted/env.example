# Bookclub, hosted: the settings for compose.yaml (README.md is the runbook).
#
# Copy this file to .env next to compose.yaml, make it readable by root only
# (chmod 600 .env), and replace every CHANGE_ME. Compose reads .env twice: for the ${…} in
# compose.yaml, and as the app container's environment. A line "#NAME=value" shows a default
# or a value the image sets; remove the "#" only to change it. The server's variables are
# described in docs/phase1/conventions.md §11.
#
# server/tests/deploy_env.rs fails when the server reads a variable this file does not name.

# ---- Compose --------------------------------------------------------------------------------

# The image tag the app follows. `stable` follows the highest release; an exact version (e.g.
# 0.11.0) holds updates back or rolls back to it. update.sh (bookclub-update.timer) carries out
# every change of the tag, with a backup first (README.md, "Updates and rollback").
BOOKCLUB_TAG=stable
# The host address and port the app is published on. Only the reverse proxy (Caddy) may reach
# it: a rule in the Proxmox firewall of the VM, because Docker's published ports pass by the
# VM's own INPUT rules (README.md, "The VM's network").
BOOKCLUB_LISTEN=0.0.0.0
BOOKCLUB_PORT=8080
# The host directory with media/ (uploaded and fetched pictures) and legal/ (the legal texts).
# Both belong to uid 1000.
BOOKCLUB_DATA_DIR=/srv/bookclub
# The file compose hands to the app container. CI points it at ci.env.
#BOOKCLUB_ENV_FILE=.env
# The restart policy of both services. CI sets `no`, so that a stack a cancelled run left
# behind does not come back with the Docker daemon.
#BOOKCLUB_RESTART=unless-stopped

# The database password, for the postgres service and DATABASE_URL below. Letters and digits
# only, so the URL needs no escaping: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# ---- The server -----------------------------------------------------------------------------

DATABASE_URL=postgres://bookclub:${POSTGRES_PASSWORD}@postgres:5432/bookclub

# The public origin, scheme://host[:port]: links in mails and invites, the origin check, the
# User-Agent of catalog requests and the calendar feeds.
PUBLIC_URL=https://bookclub.example.com
# The public name (#50): /api/config and the mails.
SERVICE_NAME=Bookclub
# The reverse proxy's address as the app sees it (CIDRs or addresses, comma-separated; `none`
# when clients connect directly). Here (Q7, option A): the address of the Caddy that serves
# git.tillhome.de, which reaches the app VM without source NAT, as <Caddy IP>/32. Only these
# addresses may set X-Forwarded-For, and the rate limits count per client from it. A wrong value
# puts every user into one rate-limit bucket, Caddy's: one client's failed attempts lock everyone
# out of sign-up and reset. A wider one lets any machine in it forge X-Forwarded-For. Filled in
# when the VM exists; README.md, "The VM's network", shows how to read the address the app sees.
TRUSTED_PROXIES=CHANGE_ME
# The public contact and takedown address. It goes into the User-Agent of catalog requests.
CONTACT_EMAIL=contact@bookclub.example.com

# Mail. Without DEV_MODE the server does not start without SMTP_URL and EMAIL_FROM, so staging
# needs an SMTP account too. SMTP_URL must use TLS: smtps://…:465, or smtp://…:587?tls=required.
# Check it with: docker compose exec app bookclub-server send-test-mail you@example.com
#EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@smtp.example.eu:465
EMAIL_FROM=Bookclub <noreply@bookclub.example.com>

# `invite` (closed beta: sign-up needs an invite) or `open` (#55).
SIGNUP_MODE=invite

# The legal texts (#53): the generator's HTML fragments, mounted read-only from
# ${BOOKCLUB_DATA_DIR}/legal.
LEGAL_DIR=/app/legal

# The DNB harvester. Keep it off until the legacy import is done (#52).
DNB_HARVEST=false
#DNB_HARVEST_INTERVAL_MINUTES=240
#DNB_HARVEST_SETS=dnb-all:reiheN,dnb:reiheA
#DNB_HARVEST_START_DAYS=90

# Set by the image; compose.yaml's port and mounts depend on them.
#BIND_ADDR=0.0.0.0:8080
#STATIC_DIR=/app/static
#MEDIA_DIR=/data/media

# Defaults that production keeps.
#DEV_MODE=false
#COOKIE_SECURE=true
#CORS_ORIGINS=
#OPENLIBRARY_URL=https://openlibrary.org
#OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
#DNB_SRU_URL=https://services.dnb.de/sru/dnb
#DNB_OAI_URL=https://services.dnb.de/oai/repository
#RUST_LOG=info
