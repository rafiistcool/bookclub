# Bookclub, hosted: the settings for the image smoke test (smoke-test.sh, the `image` job of
# .forgejo/workflows/ci.yml). It boots compose.yaml with these values instead of a filled-in .env.
#
# Nothing here is a secret, and no mail leaves: SMTP_URL points at a loopback port where nothing
# listens, which the server accepts without TLS. The environment overrides the compose values
# below; CI makes COMPOSE_PROJECT_NAME, BOOKCLUB_TAG and BOOKCLUB_DATA_DIR unique per run.
#
# server/tests/deploy_env.rs checks that this file names only what env.example names and that the
# server accepts it as a production configuration (no DEV_MODE).

# ---- Compose --------------------------------------------------------------------------------

# Never `bookclub`, the production project, which may run on the same Docker daemon.
COMPOSE_PROJECT_NAME=bookclub-ci
# The image smoke-test.sh builds: git.tillhome.de/rafiistcool/bookclub-server:<tag>.
BOOKCLUB_TAG=ci
# Port 0 is a free port, so parallel runs never collide. The test talks to the app over the
# compose network, not through this port.
BOOKCLUB_LISTEN=127.0.0.1
BOOKCLUB_PORT=0
# A directory on the Docker daemon's host, which smoke-test.sh creates and removes through a
# helper container: a CI job runs in a container of its own, whose file system is not the
# daemon's.
BOOKCLUB_DATA_DIR=/tmp/bookclub-ci
# compose.yaml hands this file to the app container (relative to compose.yaml).
BOOKCLUB_ENV_FILE=ci.env

POSTGRES_PASSWORD=ci-only-not-a-secret

# ---- The server -----------------------------------------------------------------------------

DATABASE_URL=postgres://bookclub:${POSTGRES_PASSWORD}@postgres:5432/bookclub
PUBLIC_URL=http://bookclub-ci.invalid
SERVICE_NAME=Bookclub CI
TRUSTED_PROXIES=none
CONTACT_EMAIL=ci@bookclub-ci.invalid
SMTP_URL=smtp://localhost:2525
EMAIL_FROM=Bookclub CI <noreply@bookclub-ci.invalid>
SIGNUP_MODE=invite
LEGAL_DIR=/app/legal
DNB_HARVEST=false
