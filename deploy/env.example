# Usable production env. Copy to the repo root:
#   cp deploy/env.example .env
# Same keys as `.env.example`. Empty secrets generate files under ./data.

BOOKCLUB_NAME=Bookclub

# BOOKCLUB_THEME=#b44a2a
# BOOKCLUB_THEME_DARK=#8e361c

# Canonical URL of this instance (same host as the UI). Not a split API origin.
# BOOKCLUB_PUBLIC_URL=https://books.example.com

SECRET_KEY=
BOOKCLUB_BOOTSTRAP_INVITE=

DEBUG=0
BOOKCLUB_HTTPS=auto

# Host proxy (bare metal / systemd): use 127.0.0.1
# BOOKCLUB_TRUSTED_PROXIES=127.0.0.1

# BOOKCLUB_PORT=8000
# BOOKCLUB_DOMAIN=books.example.com
# BOOKCLUB_DATA=./data
# PUID=1000
# PGID=1000

# Club timezone for meeting labels (IANA name). Default UTC.
# BOOKCLUB_TZ=Europe/Berlin

# Web Push. Leave empty to generate a key pair into <data>/.vapid_private.pem.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
