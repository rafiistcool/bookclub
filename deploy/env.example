# Copy to the repo root as `.env` (or export these in your process manager).
# Empty SECRET_KEY / BOOKCLUB_BOOTSTRAP_INVITE are fine: the app writes
# long random values into the data directory on first start.

# SECRET_KEY=
# BOOKCLUB_BOOTSTRAP_INVITE=

DEBUG=0
BOOKCLUB_HTTPS=auto

# Host port published by Compose (container always listens on 8000).
# BOOKCLUB_PORT=8000

# Hostname for the optional Caddy profile (`docker compose --profile proxy up -d`).
# BOOKCLUB_DOMAIN=books.example.com

# Bind-mount for SQLite + generated secrets. Default is ./data
# BOOKCLUB_DATA=./data

# Runtime user inside the container (match the host account that owns the data dir).
# PUID=1000
# PGID=1000

# Comma-separated proxy IPs allowed to set X-Forwarded-*. Default * is correct
# when the container is not published directly to the internet.
# BOOKCLUB_TRUSTED_PROXIES=*
