# Required in production (DEBUG=0). Any long random string is fine.
SECRET_KEY=dev-secret-change-me

# First unused invite, created only when the database has none.
# Share this once, then mint more from the Invites page.
BOOKCLUB_BOOTSTRAP_INVITE=DEV-ONLY

# 1 for local Vite + uvicorn. 0 when serving the built SPA.
DEBUG=1

# Set to 1 behind HTTPS so the session cookie is Secure.
BOOKCLUB_HTTPS=0

# Defaults to <repo>/data/bookclub.db
# DATABASE_PATH=/data/bookclub.db
