# Local development defaults (DEBUG=1, invite DEV-ONLY).
# For a shared instance copy deploy/env.example instead — see SELFHOST.md.

# Required in production (DEBUG=0) unless the data directory is writable;
# then a long random key is generated and stored in data/.secret_key.
SECRET_KEY=dev-secret-change-me

# First unused invite, created only when the database has none.
# Share this once, then mint more from the Invites page.
BOOKCLUB_BOOTSTRAP_INVITE=DEV-ONLY

# 1 for local Vite + uvicorn. 0 when serving the built SPA / Docker.
DEBUG=1

# auto: Secure cookie only when the request is HTTPS (including via a reverse proxy).
# 1: always Secure. 0: never Secure (plain HTTP LAN).
BOOKCLUB_HTTPS=auto

# Defaults to <repo>/data/bookclub.db
# DATABASE_PATH=/data/bookclub.db
