# Copy to `.env`, set your club name and secrets, then:
#   docker compose up --build -d
# Bare metal (from the repo root):
#   cp .env.example .env   # or: cp deploy/env.example .env
#   then build the frontend and run uvicorn — see SELFHOST.md
#
# Empty SECRET_KEY / BOOKCLUB_BOOTSTRAP_INVITE generate files under ./data.
# Do not leave DEV-ONLY or the example secret when DEBUG=0.

# Shown in the UI, tab title, manifest, and Open Library User-Agent.
BOOKCLUB_NAME=Bookclub

# Optional accent colors (#rgb or #rrggbb). Dark defaults to a shaded accent.
# BOOKCLUB_THEME=#b44a2a
# BOOKCLUB_THEME_DARK=#8e361c

# Canonical public origin of *this* instance (https://books.example.com).
# The Vue app calls relative /api, so put a reverse proxy on the same host.
# This is not a split frontend/API URL.
# BOOKCLUB_PUBLIC_URL=https://books.example.com

SECRET_KEY=
BOOKCLUB_BOOTSTRAP_INVITE=

# Compose and this file default to 0. /api/docs is off unless this is 1.
DEBUG=0

# auto: Secure cookie only on HTTPS (including X-Forwarded-Proto from a trusted proxy).
BOOKCLUB_HTTPS=auto

# Who may set X-Forwarded-*. * is fine when :8000 is not on the public internet.
# Bare metal behind a host proxy: 127.0.0.1
# BOOKCLUB_TRUSTED_PROXIES=*

# Host port published by Compose (container always listens on 8000).
# BOOKCLUB_PORT=8000

# Required for docker-compose.proxy.yml (do not use localhost).
# BOOKCLUB_DOMAIN=books.example.com

# BOOKCLUB_DATA=./data
# PUID=1000
# PGID=1000
# DATABASE_PATH=/data/bookclub.db

# Local Vite + uvicorn (not Docker): set these instead of the production values.
# DEBUG=1
# SECRET_KEY=dev-secret-change-me
# BOOKCLUB_BOOTSTRAP_INVITE=DEV-ONLY
